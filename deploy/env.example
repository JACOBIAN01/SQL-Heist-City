# Copy to .env on the host and fill in. Never commit the filled-in file.
IMAGE_PREFIX=ghcr.io/OWNER/REPO
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/heist?sslmode=require
GAME_ORIGINS=https://heist.example.org
# Public names (DNS must point at this machine) and the address Let's Encrypt registers certificates to.
SITE=heist.example.org
ADMIN_SITE=admin.heist.example.org
ACME_EMAIL=you@example.org
# Behind a CDN, its address ranges (docs/operations.md, "CDN"); otherwise leave out.
# TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22
# Make each with: openssl rand -base64 32   (different values; at least 32 characters)
TICKET_SECRET=
INTERNAL_SECRET=
COOKIE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
