    {
      "slug": "b-plan-target-branch",
      "tier": 1,
      "topic": ["group-by", "aggregate"],
      "title": "Pick the Target Branch",
      "rcsbe": "B",
      "bloom": "create",
      "story_md": "Next round the crew hits **one branch**. Decide which branch is worth it and why, using `accounts`.\n\nWrite your goal, when you are done, your queries (in the editor) and how you know your answer is right.",
      "schema_sql": "CREATE TABLE accounts (id INTEGER PRIMARY KEY, owner TEXT, branch TEXT, balance INTEGER, opened TEXT);\nCREATE TABLE transactions (id INTEGER PRIMARY KEY, account_id INTEGER, amount INTEGER, at TEXT);",
      "data_gen": {
        "accounts": {
          "rows": [40, 60],
          "columns": {
            "id": {
              "kind": "serial"
            },
            "owner": {
              "kind": "pick",
              "from": [
                "Ana",
                "Ben",
                "Cy",
                "Di",
                "Eli",
                "Fay",
                "Gus",
                "Hal",
                "Ida",
                "Jo",
                "Kai",
                "Lu"
              ]
            },
            "branch": {
              "kind": "pick",
              "from": ["North", "South", "East", "West", "Harbor"]
            },
            "balance": {
              "kind": "int",
              "min": 0,
              "max": 20000,
              "step": 1
            },
            "opened": {
              "kind": "date",
              "from": "2015-01-01",
              "to": "2025-12-31"
            }
          }
        },
        "transactions": {
          "rows": [60, 90],
          "columns": {
            "id": {
              "kind": "serial"
            },
            "account_id": {
              "kind": "fk",
              "table": "accounts",
              "column": "id"
            },
            "amount": {
              "kind": "int",
              "min": -2000,
              "max": 3000,
              "step": 10
            },
            "at": {
              "kind": "date",
              "from": "2023-01-01",
              "to": "2025-12-31"
            }
          }
        }
      },
      "params": {},
      "task": {
        "kind": "brief",
        "rubric": [
