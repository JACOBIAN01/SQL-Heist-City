      },
      "task": {
        "kind": "faster",
        "slow_sql": "SELECT id, balance FROM accounts WHERE lower(owner) = lower({owner|sql});",
        "max_scans": 0
      },
      "reference_sql": "SELECT id, balance FROM accounts WHERE owner = {owner|sql};",
