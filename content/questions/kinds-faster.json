      "slug": "s-faster-function",
      "tier": 3,
      "topic": ["index", "where"],
      "title": "Name Lookup",
      "rcsbe": "S",
      "bloom": "apply",
      "story_md": "Return **id** and **balance** of accounts owned by **{owner}**. Make the slow query use the index on owner.",
      "schema_sql": "CREATE TABLE accounts (id INTEGER PRIMARY KEY, owner TEXT, branch TEXT, balance INTEGER, opened TEXT);\nCREATE TABLE transactions (id INTEGER PRIMARY KEY, account_id INTEGER, amount INTEGER, at TEXT);\nCREATE INDEX accounts_owner ON accounts(owner);\nCREATE INDEX accounts_branch ON accounts(branch);\nCREATE INDEX accounts_balance ON accounts(balance);\nCREATE INDEX transactions_account ON transactions(account_id);\nCREATE INDEX transactions_at ON transactions(at);",
      "data_gen": {
        "accounts": {
          "rows": [40, 60],
          "columns": {
            "id": {
              "kind": "serial"
            },
            "owner": {
              "kind": "pick",
              "from": [
                "Ana",
                "Ben",
                "Cy",
                "Di",
                "Eli",
                "Fay",
                "Gus",
                "Hal",
                "Ida",
                "Jo",
                "Kai",
                "Lu"
              ]
            },
            "branch": {
              "kind": "pick",
              "from": ["North", "South", "East", "West", "Harbor"]
            },
            "balance": {
              "kind": "int",
              "min": 0,
              "max": 20000,
              "step": 1
            },
            "opened": {
              "kind": "date",
              "from": "2015-01-01",
              "to": "2025-12-31"
            }
          }
        },
        "transactions": {
          "rows": [60, 90],
          "columns": {
            "id": {
              "kind": "serial"
            },
            "account_id": {
              "kind": "fk",
              "table": "accounts",
              "column": "id"
            },
            "amount": {
              "kind": "int",
              "min": -2000,
              "max": 3000,
              "step": 10
            },
            "at": {
              "kind": "date",
              "from": "2023-01-01",
              "to": "2025-12-31"
            }
          }
        }
      },
      "params": {
        "owner": {
          "kind": "pick",
          "from": ["Ana", "Ben", "Cy", "Di", "Eli", "Fay", "Gus", "Hal", "Ida", "Jo", "Kai", "Lu"]
