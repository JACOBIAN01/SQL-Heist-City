{
  "name": "@heist/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "bot": "tsx src/tools/walkBot.ts",
    "load:bots": "tsx src/tools/loadBots.ts",
    "fuzz:sql": "tsx src/tools/fuzzSql.ts",
    "grader:stress": "tsx src/tools/graderStress.ts",
    "capacity": "tsx src/tools/capacity.ts",
    "backup:pg": "tsx src/tools/pgBackupCli.ts",
    "soak": "node --expose-gc --import tsx src/tools/soak.ts",
    "db:migrate": "tsx src/tools/migratePg.ts",
    "db:import-sqlite": "tsx src/tools/importSqlite.ts"
  },
  "dependencies": {
    "@heist/shared": "*",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
