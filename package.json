{
  "name": "sql-heist-city",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "admin",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @heist/server",
    "dev:admin": "npm run dev -w @heist/admin",
    "dev:client": "npm run dev -w @heist/client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @heist/admin -w @heist/client",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run questions:validate && npm run build",
    "questions:validate": "npm run questions:validate -w @heist/admin --",
    "db:seed": "npm run db:seed -w @heist/admin --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
