{
  "name": "sql-heist-city",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "admin",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @heist/server",
    "dev:admin": "npm run dev -w @heist/admin",
    "dev:client": "npm run dev -w @heist/client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "legal": "node scripts/build-legal.mjs",
    "build": "node scripts/build-legal.mjs && npm run build -w @heist/admin -w @heist/client",
    "ci": "node scripts/check-secrets.mjs && npm run format:check && npm run lint && npm run typecheck && npm test && npm run questions:validate && npm run build && npm run size",
    "questions:validate": "npm run questions:validate -w @heist/admin --",
    "db:seed": "npm run db:seed -w @heist/admin --",
    "size": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test",
    "load:bots": "npm run load:bots -w @heist/server --",
    "db:migrate": "npm run db:migrate -w @heist/server --",
    "pg:dev": "node scripts/pg-dev.mjs",
    "db:import-sqlite": "npm run db:import-sqlite -w @heist/server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
