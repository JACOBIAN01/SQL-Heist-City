{
  "name": "@heist/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "dev:api": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "dev": "concurrently -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "build": "vite build --config ui/vite.config.ts"
  },
  "dependencies": {
    "@heist/shared": "*",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "@heist/server": "*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.2"
  }
}
