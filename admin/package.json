{
  "name": "@heist/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "dev:api": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "dev": "concurrently -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "build": "vite build --config ui/vite.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@heist/server": "*",
    "@heist/shared": "*",
    "@tanstack/react-query": "^5.104.1",
    "codemirror": "^6.0.2",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.2"
  }
}
